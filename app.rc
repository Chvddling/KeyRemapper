#include <windows.h>
#include "resource.h"

LANGUAGE 9, 1

IDI_APP ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Key Remapper - per-game keyboard remapping"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Key Remapper"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "KeyRemapper.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_MAIN DIALOGEX 0, 0, 420, 372
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Key Remapper"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  CONTROL         "", IDC_GAMES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP, 12, 64, 140, 242
  PUSHBUTTON      "Add game...", IDC_ADDGAME, 14, 313, 66, 15
  PUSHBUTTON      "Remove", IDC_REMGAME, 84, 313, 66, 15

  LTEXT           "Select or add a game on the left.", IDC_GAMEPATH, 171, 65, 235, 9, SS_PATHELLIPSIS | SS_NOPREFIX
  CONTROL         "Remap keys for this game", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 171, 77, 200, 10
  CONTROL         "", IDC_MAPS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP, 169, 91, 239, 70
  PUSHBUTTON      "Add...", IDC_ADDMAP, 171, 166, 56, 15
  PUSHBUTTON      "Edit...", IDC_EDITMAP, 230, 166, 56, 15
  PUSHBUTTON      "Remove", IDC_REMMAP, 289, 166, 56, 15
  PUSHBUTTON      "Copy from...", IDC_COPYFROM, 348, 166, 58, 15
  CONTROL         "Scancode-only output (try this if a game ignores the remaps)", IDC_SCANONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 171, 186, 235, 10

  LTEXT           "Window mode:", -1, 171, 232, 55, 9
  COMBOBOX        IDC_DISPMODE, 228, 230, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Upscaling:", -1, 171, 248, 55, 9
  COMBOBOX        IDC_METHOD, 228, 246, 178, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Aspect ratio:", -1, 171, 264, 55, 9
  COMBOBOX        IDC_ASPECT, 228, 262, 76, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Size:", -1, 310, 264, 28, 9
  COMBOBOX        IDC_SCALING, 340, 262, 66, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT           "Pixels:", -1, 171, 280, 55, 9
  COMBOBOX        IDC_FILTER, 228, 278, 76, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  CONTROL         "Sharp on high-DPI screens (no Windows DPI stretching)", IDC_DPIFIX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 171, 296, 235, 10
  LTEXT           "", IDC_DISPINFO, 171, 309, 172, 20, SS_NOPREFIX
  PUSHBUTTON      "Forget size", IDC_RESETSIZE, 348, 311, 58, 15

  CONTROL         "Start with Windows (in tray)", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 352, 150, 10
  PUSHBUTTON      "Pause", IDC_PAUSE, 268, 349, 70, 15
  DEFPUSHBUTTON   "Hide to tray", IDC_HIDE, 343, 349, 70, 15
END

IDD_MAP DIALOGEX 0, 0, 250, 112
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Key mapping"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT           "When I press:", -1, 7, 27, 60, 9
  COMBOBOX        IDC_SRC, 70, 25, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON      "Detect", IDC_SRCCAP, 186, 24, 57, 14
  LTEXT           "Send instead:", -1, 7, 47, 60, 9
  COMBOBOX        IDC_DST, 70, 45, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON      "Detect", IDC_DSTCAP, 186, 44, 57, 14
  LTEXT           "Tip: click Detect, then press the key on your keyboard.", IDC_HINT, 7, 66, 236, 16
  DEFPUSHBUTTON   "OK", IDOK, 132, 92, 54, 15
  PUSHBUTTON      "Cancel", IDCANCEL, 190, 92, 54, 15
END
